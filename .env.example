# =============================================================================
# Local development / deploy-script environment variables.
#
# Copy to `.env` and fill in your own values. `.env` is gitignored.
# In-cluster credentials use IRSA (set up via scripts/setup-iam-gateway.sh)
# so no AWS_ACCESS_KEY_ID/SECRET is needed in production. The deploy and
# build scripts pick up the values below to substitute ECR URIs etc.
# =============================================================================

# ---- AWS / Account ----------------------------------------------------------
# Used by scripts/build-and-push.sh, scripts/create-cluster.sh, and
# scripts/deploy.sh to compute ECR URIs and target the right region.
AWS_ACCOUNT_ID=PLACEHOLDER_AWS_ACCOUNT_ID
AWS_REGION=us-east-1

# ---- vLLM model -------------------------------------------------------------
# These mirror kubernetes/configmap.yaml; only used for local docker-compose.
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.9

# ---- HuggingFace / API auth -------------------------------------------------
# HF_TOKEN: required for gated models (e.g. Llama 3.1).
#   1) Accept license: https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct
#   2) Generate token: https://huggingface.co/settings/tokens
# VLLM_API_KEY: any strong random string. Generate with: openssl rand -hex 32
# Required — the gateway refuses to start without it.
HF_TOKEN=PLACEHOLDER_HF_TOKEN
VLLM_API_KEY=PLACEHOLDER_API_KEY

# ---- TLS (gateway NLB) ----------------------------------------------------
# ACM certificate ARN for the public API hostname (must be in the same region as EKS).
# Used by scripts/deploy.sh to terminate HTTPS on the gateway Network Load Balancer.
# Example: arn:aws:acm:us-east-1:123456789012:certificate/abcd1234-...
ACM_CERT_ARN=PLACEHOLDER_ACM_CERT_ARN

# ---- OpenAI gpt-4o-mini (optional) ------------------------------------------
# Shared key for the input guard (jailbreak / off-scope) and query rewrite
# (follow-ups -> standalone search queries). Leave empty to skip both
# (chat still works; rewrite falls back to the literal user message).
# INPUT_GUARD_ENABLED=true
# OPENAI_API_KEY=

# ---- EKS / ECR --------------------------------------------------------------
EKS_CLUSTER_NAME=vllm-cluster
ECR_REPOSITORY_NAME=vllm-server
IMAGE_TAG=latest

# ---- DynamoDB / OpenSearch (used by setup scripts and the gateway pod) -----
DYNAMODB_TABLE=vllm-conversations
OPENSEARCH_DOMAIN_NAME=vllm-rag
# Filled in after scripts/setup-opensearch.sh completes.
# deploy.sh injects this into kubernetes/gateway-configmap.yaml (leave empty to disable RAG).
OPENSEARCH_ENDPOINT=

# ---- Document upload / smoke tests ------------------------------------------
# Used by scripts/upload-docs.sh; if unset, the script reads the
# gateway-service hostname from kubectl.
GATEWAY_URL=

# Persona / scope / canned refusal. deploy.sh injects this into the gateway
# ConfigMap; docker compose reads it directly. Match the corpus in docs/.
DESIRED_RAG_TOPIC="Desired RAG Topic"

# =============================================================================
# Token budget + RAG knobs (defaults shipped in gateway-configmap.yaml).
# Override here only for local docker-compose runs that bypass Kubernetes.
# Full reference: gateway/RAG_ARCHITECTURE.md
# =============================================================================
# MODEL_CONTEXT_TOKENS=4096          # MUST equal MAX_MODEL_LEN
# RAG_ENABLED=true                   # the only RAG kill-switch
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.35                 # post-rerank score floor
# CHUNK_SIZE=2000
# CHUNK_OVERLAP=200
